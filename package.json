{
  "name": "james-peak-atlas",
  "version": "0.0.0",
  "private": true,
  "description": "React + TypeScript + Tailwind rebuild of the James Peak Scouting Atlas",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "dev:private": "vite --mode private",
    "check:data": "node reference/scripts/check.mjs && node scripts/check-data.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "vite build && node scripts/copy-reference.mjs",
    "build:private": "vite build --mode private",
    "check:build": "node scripts/check-public-build.mjs",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:e2e:private": "playwright test --config playwright.private.config.ts"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
